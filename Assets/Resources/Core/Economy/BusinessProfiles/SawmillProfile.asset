  - {itemId: sawn_lumber_bundle, displayName: Lumber Bundle, categoryId: lumber, unit: bundle, pricing: {baselineCents: 85, localMarketBand: {minCents: 65, maxCents: 130}, markupMultiplier: 1, supplyDemandSensitivity: 0.35}, startingStockUnits: 240, reorderTargetUnits: 360, reorderLotSize: 24, coreStock: 1, producerTags: [sawmill], consumerTags: [construction, household_upgrade]}
