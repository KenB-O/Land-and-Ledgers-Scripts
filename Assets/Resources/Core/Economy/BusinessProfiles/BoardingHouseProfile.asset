  - {itemId: boarding_meat_lot, displayName: Boarding Meat Lot, categoryId: meat, unit: lot, pricing: {baselineCents: 130, localMarketBand: {minCents: 90, maxCents: 210}, markupMultiplier: 1, supplyDemandSensitivity: 0.35}, startingStockUnits: 6, reorderTargetUnits: 18, reorderLotSize: 4, coreStock: 1, producerTags: [butcher], consumerTags: [boarding_house]}
